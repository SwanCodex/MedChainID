{
  "meta": {
    "project": "MedChainID",
    "date": "2025-12-18",
    "prepared_by": "Product Manager"
  },
  "product_overview": "MedChainID is a decentralized medical record verification system built on the Aptos blockchain. It ensures privacy, data integrity, and fraud prevention by encrypting sensitive medical documents off-chain, storing cryptographic proofs on-chain, and leveraging AI-powered fraud detection.",
  "core_goals": [
    "Provide a secure and privacy-first platform for issuing and verifying medical records.",
    "Prevent fraud through one-time-use token mechanisms and ML-based fraud detection.",
    "Enable tamper-resistant storage of medical records using blockchain and IPFS.",
    "Support seamless authentication via Google OAuth and wallet integration.",
    "Facilitate easy verification and consumption of medical record tokens by authorized parties."
  ],
  "key_features": [
    "Document upload with automatic text extraction, ML fraud analysis, AES-256 encryption, and IPFS storage.",
    "One-time-use token issuance and management on the Aptos blockchain with Petra wallet integration.",
    "Google OAuth based user authentication with JWT session management.",
    "API endpoints for document upload, verification, decryption, and token verification/consumption.",
    "ML fraud detection engine that uses OCR and AI to analyze document authenticity.",
    "Frontend interfaces for issuers to upload and issue tokens and for verifiers to verify and consume tokens.",
    "Secure cryptographic operations including SHA-256 hashing and AES-256-CBC encryption."
  ],
  "user_flow_summary": [
    "User authenticates via Google OAuth or connects Aptos wallet to access the system.",
    "Issuer uploads a medical document, selects record type, and initiates issuance.",
    "System processes the document: hashes, runs ML fraud detection, encrypts, uploads to IPFS, and mints a blockchain token.",
    "Issuer receives token ID and issuer address to share with verifiers.",
    "Verifier inputs token details and queries blockchain for token validity and document metadata.",
    "Verifier can download encrypted document from IPFS and decrypt with authorized key for viewing.",
    "Verifier consumes token on blockchain to prevent double-use fraud if authorized."
  ],
  "validation_criteria": [
    "Documents must be successfully hashed, encrypted, and uploaded to IPFS, returning valid hash and CID.",
    "ML fraud detection must analyze documents and flag risks accurately with confidence scores.",
    "Tokens must be minted, verified, and consumed correctly on the Aptos blockchain.",
    "Users must authenticate securely via Google OAuth and maintain session via JWT without leaks.",
    "APIs must handle error cases gracefully including missing files, invalid tokens, and server errors.",
    "Frontend must provide seamless workflows for issuers and verifiers with clear status feedback.",
    "Encryption keys must be securely handled and used to decrypt documents fetched from IPFS.",
    "System must maintain one-time-use token enforcement to prevent double-claiming and fraud."
  ],
  "code_summary": {
    "tech_stack": [
      "JavaScript",
      "TypeScript",
      "React",
      "Vite",
      "Node.js",
      "Express",
      "Flask",
      "Python",
      "Tailwind CSS",
      "Ant Design",
      "Aptos blockchain",
      "IPFS",
      "Pinata",
      "Google OAuth"
    ],
    "features": [
      {
        "name": "Document Upload and Verification",
        "description": "Accepts a medical document, extracts text (for PDFs), runs fraud detection via the ML engine, encrypts the file, uploads it to IPFS, and returns a hash, IPFS CID, and risk analysis.",
        "files": [
          "backend/src/server.js",
          "backend/src/utils/encryption.js",
          "backend/src/utils/ipfs.js",
          "ml-engine/app.py",
          "ml-engine/model.py",
          "frontend/src/pages/Issuer.tsx",
          "frontend/src/pages/IssueRecordPage.tsx",
          "frontend/src/pages/PatientDashboard.tsx",
          "frontend/src/services/api.ts"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Document Upload and Verification API",
            "version": "1.0.0",
            "description": "APIs for uploading, verifying, and retrieving encrypted medical documents with ML fraud analysis."
          },
          "paths": {
            "/api/upload": {
              "post": {
                "summary": "Upload and verify a medical document",
                "description": "Uploads a document, generates a hash, optionally extracts text and runs ML analysis, encrypts the file, and uploads it to IPFS.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "document": {
                            "type": "string",
                            "format": "binary",
                            "description": "The document file (PDF or image) to upload and verify."
                          }
                        },
                        "required": [
                          "document"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Upload and analysis successful",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "docHash": {
                              "type": "string",
                              "description": "SHA-256 hash of the original document."
                            },
                            "ipfsCid": {
                              "type": "string",
                              "description": "IPFS CID of the encrypted file."
                            },
                            "riskAnalysis": {
                              "type": "object",
                              "description": "ML fraud analysis result.",
                              "properties": {
                                "verified": {
                                  "type": "boolean"
                                },
                                "confidence": {
                                  "type": "number"
                                },
                                "message": {
                                  "type": "string"
                                },
                                "riskFlags": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "metadata": {
                              "type": "object",
                              "properties": {
                                "filename": {
                                  "type": "string"
                                },
                                "fileSize": {
                                  "type": "integer"
                                },
                                "mimeType": {
                                  "type": "string"
                                },
                                "processingTime": {
                                  "type": "string"
                                },
                                "timestamp": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              }
                            }
                          },
                          "required": [
                            "success",
                            "docHash",
                            "ipfsCid",
                            "riskAnalysis",
                            "metadata"
                          ]
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Validation error or missing file"
                  },
                  "500": {
                    "description": "Server error while processing the document"
                  }
                }
              }
            },
            "/api/verify": {
              "post": {
                "summary": "Verify a document against an expected hash",
                "description": "Uploads a document and compares its hash to an expected hash to check integrity.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "document": {
                            "type": "string",
                            "format": "binary",
                            "description": "The document file to verify."
                          },
                          "expectedHash": {
                            "type": "string",
                            "description": "Expected SHA-256 hash of the document."
                          }
                        },
                        "required": [
                          "document",
                          "expectedHash"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Verification result",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "valid": {
                              "type": "boolean"
                            },
                            "actualHash": {
                              "type": "string"
                            },
                            "expectedHash": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "success",
                            "valid",
                            "actualHash",
                            "expectedHash",
                            "message"
                          ]
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Missing file or expected hash"
                  },
                  "500": {
                    "description": "Server error during verification"
                  }
                }
              }
            },
            "/api/download/{cid}": {
              "get": {
                "summary": "Download encrypted document from IPFS",
                "description": "Downloads the encrypted document bytes from IPFS by CID.",
                "parameters": [
                  {
                    "name": "cid",
                    "in": "path",
                    "required": true,
                    "schema": {
                      "type": "string"
                    },
                    "description": "IPFS CID of the encrypted document."
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Encrypted document bytes",
                    "content": {
                      "application/octet-stream": {
                        "schema": {
                          "type": "string",
                          "format": "binary"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Missing CID"
                  },
                  "500": {
                    "description": "Error downloading from IPFS"
                  }
                }
              }
            },
            "/api/decrypt-view": {
              "post": {
                "summary": "Decrypt and view document from IPFS",
                "description": "Fetches the encrypted document from IPFS using its CID and decrypts it using a provided AES-256-CBC key.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "cid": {
                            "type": "string",
                            "description": "IPFS CID of the encrypted document."
                          },
                          "key": {
                            "type": "string",
                            "description": "Hex-encoded AES-256 key (64 hex characters)."
                          }
                        },
                        "required": [
                          "cid",
                          "key"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Decrypted document bytes",
                    "content": {
                      "application/pdf": {
                        "schema": {
                          "type": "string",
                          "format": "binary"
                        }
                      },
                      "image/jpeg": {
                        "schema": {
                          "type": "string",
                          "format": "binary"
                        }
                      },
                      "image/png": {
                        "schema": {
                          "type": "string",
                          "format": "binary"
                        }
                      },
                      "application/octet-stream": {
                        "schema": {
                          "type": "string",
                          "format": "binary"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Missing CID or key"
                  },
                  "500": {
                    "description": "Decryption failure"
                  }
                }
              }
            },
            "/api/health": {
              "get": {
                "summary": "Backend health check",
                "description": "Returns the health and environment information of the MedChainID backend.",
                "responses": {
                  "200": {
                    "description": "Health information",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string"
                            },
                            "service": {
                              "type": "string"
                            },
                            "version": {
                              "type": "string"
                            },
                            "timestamp": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "uptime": {
                              "type": "number"
                            },
                            "environment": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {}
        }
      },
      {
        "name": "Authentication and User Session",
        "description": "Handles Google OAuth login, JWT generation/verification, and user session management for secure access to MedChainID.",
        "files": [
          "backend/src/auth.js",
          "backend/src/authRoutes.js",
          "backend/src/server.js",
          "frontend/src/contexts/AuthContext.tsx",
          "frontend/src/pages/LoginPage.tsx",
          "frontend/src/pages/AuthCallback.tsx",
          "frontend/src/components/UserMenu.tsx",
          "frontend/src/services/api.ts"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Authentication API",
            "version": "1.0.0",
            "description": "APIs for user authentication using Google OAuth and JWT."
          },
          "paths": {
            "/api/auth/google": {
              "get": {
                "summary": "Initiate Google OAuth login",
                "description": "Redirects the user to Google for OAuth authentication.",
                "responses": {
                  "302": {
                    "description": "Redirect to Google OAuth"
                  }
                }
              }
            },
            "/api/auth/google/callback": {
              "get": {
                "summary": "Google OAuth callback",
                "description": "Handles the callback from Google OAuth, issues a JWT, and redirects to the frontend.",
                "responses": {
                  "302": {
                    "description": "Redirect to frontend with JWT token"
                  }
                }
              }
            },
            "/api/auth/google/verify": {
              "post": {
                "summary": "Verify Google ID token and issue JWT",
                "description": "Verifies a Google ID token from the client and returns a signed JWT along with basic user info.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": "string",
                            "description": "Google ID token."
                          }
                        },
                        "required": [
                          "token"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "JWT and user info returned",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "token": {
                              "type": "string",
                              "description": "JWT token."
                            },
                            "user": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "email": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "picture": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Missing token"
                  },
                  "401": {
                    "description": "Invalid token"
                  }
                }
              }
            },
            "/api/auth/user": {
              "get": {
                "summary": "Get current authenticated user",
                "description": "Returns the authenticated user from the JWT.",
                "responses": {
                  "200": {
                    "description": "User information",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "user": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  },
                  "401": {
                    "description": "Unauthorized"
                  }
                }
              }
            },
            "/api/auth/logout": {
              "post": {
                "summary": "Logout user",
                "description": "Clears authentication cookie/token and logs out the user.",
                "responses": {
                  "200": {
                    "description": "Logout successful",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/auth/status": {
              "get": {
                "summary": "Check authentication status",
                "description": "Checks if a provided JWT (via Authorization header or cookie) is valid and returns user info if authenticated.",
                "responses": {
                  "200": {
                    "description": "Authentication status",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "authenticated": {
                              "type": "boolean"
                            },
                            "user": {
                              "type": "object",
                              "nullable": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {}
        }
      },
      {
        "name": "ML Fraud Detection Engine",
        "description": "Flask-based ML engine that verifies documents via OCR and AI, used by the backend for fraud analysis.",
        "files": [
          "ml-engine/app.py",
          "ml-engine/model.py"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "ML Engine API",
            "version": "1.0.0",
            "description": "APIs for OCR-based and text-based document verification."
          },
          "paths": {
            "/api/health": {
              "get": {
                "summary": "ML engine health check",
                "description": "Returns the health and configuration status of the ML engine.",
                "responses": {
                  "200": {
                    "description": "Health information",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string"
                            },
                            "service": {
                              "type": "string"
                            },
                            "version": {
                              "type": "string"
                            },
                            "gemini_configured": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/ocr-verify": {
              "post": {
                "summary": "OCR and AI-based document verification",
                "description": "Accepts a file upload or raw text and performs AI-based verification.",
                "requestBody": {
                  "required": true,
                  "content": {
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string",
                            "format": "binary",
                            "description": "Document file for OCR and verification."
                          },
                          "recordType": {
                            "type": "string",
                            "description": "Type of medical record."
                          }
                        }
                      }
                    },
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "description": "Document text content."
                          },
                          "filename": {
                            "type": "string",
                            "description": "Original filename."
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Verification result",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean"
                            },
                            "data": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "No file or text provided"
                  },
                  "500": {
                    "description": "Server error in ML engine"
                  }
                }
              }
            }
          },
          "components": {}
        }
      }
    ]
  }
}
